WEB_PORT=8080
DB_PASSWORD=local-demo-password
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ENABLE_FAULTS=true
# Transcripción: browser (reconocimiento del navegador) u openai-compatible (Groq, Speaches…).
# Sin STT_API_KEY se usa siempre el navegador.
STT_PROVIDER=browser
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
